---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | ChronoTally">
  <div class="min-h-[80vh] flex items-center justify-center p-4">
    <div class="max-w-md w-full text-center">
      <!-- Animated 404 Number -->
      <div class="relative mb-8">
        <h1 class="text-8xl md:text-9xl font-black text-primary/20 select-none">
          404
        </h1>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-32 h-32 md:w-40 md:h-40 bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center shadow-2xl animate-pulse">
            <span class="material-symbols-rounded text-white" style="font-size: 5rem;">
              description
            </span>
          </div>
        </div>
      </div>

      <!-- Main Message -->
      <div class="mb-8 space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-base-content">
          Oops! Page Not Found
        </h2>
        <p class="text-base-content/70 text-lg leading-relaxed">
          The page you're looking for seems to have wandered off into the digital void.
          Don't worry, even the best timesheets sometimes get misplaced!
        </p>
      </div>

      <!-- Floating Elements Animation -->
      <div class="relative mb-8 h-24">
        <div class="absolute inset-0 flex items-center justify-center overflow-hidden">
          <div class="animate-bounce delay-100">
            <div class="w-4 h-4 bg-primary rounded-full opacity-60"></div>
          </div>
          <div class="animate-bounce delay-200 ml-8">
            <div class="w-3 h-3 bg-secondary rounded-full opacity-70"></div>
          </div>
          <div class="animate-bounce delay-300 ml-6">
            <div class="w-2 h-2 bg-accent rounded-full opacity-80"></div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/"
             class="btn btn-primary btn-lg gap-2 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105">
            <span class="material-symbols-rounded text-xl">
              home
            </span>
            Take Me Home
          </a>

          <a href="/timesheets"
             class="btn btn-secondary btn-lg gap-2 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105">
            <span class="material-symbols-rounded text-xl">
              schedule
            </span>
            View Timesheets
          </a>
        </div>

        <!-- Go Back Button -->
        <button onclick="history.back()"
                class="btn btn-ghost btn-sm gap-2 text-base-content/60 hover:text-base-content transition-colors duration-200">
          <span class="material-symbols-rounded text-base">
            arrow_back
          </span>
          Go Back
        </button>
      </div>

      <!-- Helpful Links -->
      <div class="mt-12 pt-8 border-t border-base-300">
        <p class="text-sm text-base-content/50 mb-4">Need help? Try these popular pages:</p>
        <div class="flex flex-wrap justify-center gap-2">
          <a href="/" class="link link-hover text-sm text-base-content/60">Home</a>
          <span class="text-base-content/30">•</span>
          <a href="/timesheets" class="link link-hover text-sm text-base-content/60">Timesheets</a>
          <span class="text-base-content/30">•</span>
          <a href="/timesheets#calendar" class="link link-hover text-sm text-base-content/60">Calendar</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Background Decorative Elements -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <!-- Subtle Grid Pattern -->
    <div class="absolute inset-0 opacity-5">
      <div class="h-full w-full" style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 50px 50px;"></div>
    </div>

    <!-- Floating Shapes -->
    <div class="absolute top-20 left-10 w-32 h-32 bg-primary/5 rounded-full animate-pulse"></div>
    <div class="absolute bottom-20 right-10 w-48 h-48 bg-secondary/5 rounded-full animate-pulse animation-delay-1000"></div>
    <div class="absolute top-1/2 left-1/4 w-24 h-24 bg-accent/5 rounded-full animate-pulse animation-delay-2000"></div>
  </div>
</Layout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }

  .animation-delay-1000 {
    animation-delay: 1s;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  /* Custom gradient text effect */
  .gradient-text {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
